<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#000000">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="System Protection"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="30dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingiza Parent Code kufuta app:"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/uninstallCodeInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Parent Code"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:backgroundTint="#FFFFFF"
        android:textAllCaps="true"
        android:maxLength="8"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/uninstallSubmitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Futa App"
        android:backgroundTint="#FF0000"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ App hii ina data muhimu. Futa tu kama ni lazima."
        android:textColor="#FFA500"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="20dp" />

</LinearLayout>
